# Backend. The Docker/Compose configuration uses this container path.
# For a local backend started from backend/, use data/nutri_scan.sqlite3 instead.
NUTRI_SCAN_DB=/data/nutri_scan.sqlite3
NUTRI_SCAN_ORIGINS=
NUTRI_SCAN_COOKIE_SECURE=false

# Optional directory containing the built frontend. Docker sets this automatically.
NUTRI_SCAN_STATIC_DIR=

# Frontend development uses the Vite proxy by default.
# For a separately hosted production frontend, use the explicit API origin.
VITE_PUBLIC_API_URL=
# Optional local Vite proxy target (defaults to http://127.0.0.1:8000).
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Legacy name accepted for production builds.
VITE_API_URL=
